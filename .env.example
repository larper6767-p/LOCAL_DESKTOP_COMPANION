# environment variables (API keys).
# Copy this file to ".env" in this folder and fill in YOUR OWN keys.
# Never share your .env.

# Fish Audio - voice synthesis. Get a key at https://fish.audio
FISH_API_KEY=your_fish_api_key_here

# Cerebras - the LLM "brain". Get a key at https://cloud.cerebras.ai
CEREBRAS_API_KEY=your_cerebras_api_key_here
